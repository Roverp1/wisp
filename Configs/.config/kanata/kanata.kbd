;; configurate kanata behaviour
(defcfg
  process-unmapped-keys yes
)

;; defines the order of keys that the `deflayer` entries will operate on
(defsrc
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12             del  home   end ins
  grv   1    2    3    4    5    6    7    8    9    0    -    =      bspc           nlck kp/    kp* kp-
  tab   q    w    e    r    t    y    u    i    o    p    [    ]      \              kp7  kp8    kp9 kp+
  caps  a    s    d    f    g    h    j    k    l    ;    '           ret            kp4  kp5    kp6
  lsft  z    x    c    v    b    n    m    ,    .    /               rsft  up        kp1  kp2    kp3 kprt
  lctl       lmet lalt           spc            ralt      rctl       left down rght  kp0  kp.
)

;; defines variables
(defvar
  tap-time 170
  hold-time 300

  left-hand-keys (
      grv   1    2    3    4    5
      tab   q    w    e    r    t
      ;; caps  a    s    d    f    g
      lsft  z    x    c    v    b
      lctl    
  )
  right-hand-keys (
      6    7    8    9    0    -    =      bspc
      y    u    i    o    p    [    ]      \
      ;; h    j    k    l    ;    '           ret
      n    m    ,    .    /               rsft
      rctl
  )
)

;; defines how each physical key mapped in `defsrc` behaves when kanata runs
(deflayer base
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12             del  home   end ins
  grv   1    2    3    4    5    6    7    8    9    0    -    =      bspc           nlck kp/    kp* kp-
  tab   q    w    e    r    t    y    u    i    o    p    [    ]      \              kp7  kp8    kp9 kp+
  caps  @a-mod  @s-mod  @d-mod  @f-mod    g    h    @j-mod    @k-mod    @l-mod    @;-mod    '           ret            kp4  kp5    kp6
  lsft  z    x    c    v    b    n    m    ,    .    /               rsft  up        kp1  kp2    kp3 kprt
  lctl       lmet lalt           spc            ralt      rctl       left down rght  kp0  kp.
)

(deflayer nomods
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12             del  home   end ins
  grv   1    2    3    4    5    6    7    8    9    0    -    =      bspc           nlck kp/    kp* kp-
  tab   q    w    e    r    t    y    u    i    o    p    [    ]      \              kp7  kp8    kp9 kp+
  caps  a    s    d    f    g    h    j    k    l    ;    '           ret            kp4  kp5    kp6
  lsft  z    x    c    v    b    n    m    ,    .    /               rsft  up        kp1  kp2    kp3 kprt
  lctl       lmet lalt           spc            ralt      rctl       left down rght  kp0  kp.
)

(deffakekeys
  to-base (layer-switch base)
)

;; defines an alias - 'shortcut label' for an action
(defalias
  require-prior-idle-ms (multi 
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 100)
)

  a-mod (tap-hold-release $tap-time $hold-time a lmeta)
  s-mod (tap-hold-release $tap-time $hold-time s lalt)
  d-mod (tap-hold-release $tap-time $hold-time d lshft)
  f-mod (tap-hold-release $tap-time $hold-time f lctrl)

  j-mod (tap-hold-release $tap-time $hold-time j rctrl)
  k-mod (tap-hold-release $tap-time $hold-time k rshift)
  l-mod (tap-hold-release $tap-time $hold-time l lalt)
  ;-mod (tap-hold-release $tap-time $hold-time ; rmeta)
)

